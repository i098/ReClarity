[47.348156, "o", "\r\n$ TOOL Bash {\"command\": \"cd /tmp && cat > /tmp/rd.js <<'E'\\nconst fs=require('fs');const b=fs.readFileSync(process.argv[2]);\\nconst hl=b.readUInt32LE(12);const h=JSON.parse(b.slice(16,16+hl).toString());const base=8+b.readUInt32LE(4);\\nfunction w(n,p){for(const k in n.files){const f=n.files[k];if(f.files)w(f,p+k+'/');else if(f.size!==undefined&&!f.unpacked)console.log('== '+p+k+' ('+f.size+')\\\\n'+b.slice(base+ +f.offset,base+ +f.offset+f.size).toString())}}\\nw(h,'');\\nE\\nnode /tmp/rd.js /sdc-disk/host-data/\r\n"]
